+QUESTION_LABEL = r"(?:\b(?:Question|Q|Вопрос)\s*\d*\s*[:.)]|^\s*\d+[.)]\s+)"
+
+
+def split_questions(query: str) -> list[str]:
+    """Keep wrapped lines together, splitting at labels or completed questions."""
+    labels = list(re.finditer(QUESTION_LABEL, query, re.IGNORECASE | re.MULTILINE))
+    if labels:
+        query = query[labels[0].start():]
+    labeled = re.split(QUESTION_LABEL, query, flags=re.IGNORECASE | re.MULTILINE)
+    questions = []
+    for part in labeled:
+        pieces = [piece.strip() for piece in re.split(r"(?<=\?)\s+", part.strip()) if piece.strip()]
+        if len(pieces) > 1 and not pieces[-1].endswith("?"):
+            pieces[-2:] = [" ".join(pieces[-2:])]
+        questions.extend(pieces)
+    return questions
+
+
