+def numeric_measurement_spans(text: str) -> list[tuple[int, int]]:
+    number_pattern = re.compile(
+        r"(?<![\w.,])[-+]?(?:(?:\d{1,3}(?:[ ,.'\u00a0\u202f_]\d{3})+|\d+)"
+        r"(?:[.,]\d+)?|[.,]\d+)(?:[eE][+-]?\d+)?(?!\d|[.,]\d)"
+    )
+    unit_pattern = re.compile(
+        r"\s*(?:%|(?:tokens?|bytes?|[kmgtpe]?i?b|[numk]?s|secs?|seconds?|minutes?|hours?|"
+        r"[numk]?m|[mk]?g|hz|khz|mhz|ghz|[kmgt]?flops|fps|rpm|pa|kpa|mpa|j|kj|w|kw|mw|"
+        r"v|mv|a|ma|k|°[cf]|мс|мкс|нс|сек|с|мин|ч|байт(?:а|ов)?|токен(?:а|ов)?|"
+        r"кб|мб|гб|тб|мм|см|м|км|мг|г|кг)(?!\w))",
+        re.IGNORECASE,
+    )
+    phone_label_pattern = re.compile(
+        r"(?:\b(?:phone|telephone|tel|mobile|cell|fax|call|телефон|тел|мобильный|факс)"
+        r"\.?\s*(?:(?:number|номер|no\.?|#)\s*)?[:=]?[\s\d()+.-]*)$",
+        re.IGNORECASE,
+    )
+    spans = []
+    for number in number_pattern.finditer(text):
+        prefix = text[:number.start()]
+        if phone_label_pattern.search(prefix):
+            continue
+        value = number.group(0)
+        fractional = re.fullmatch(r"[-+]?\d*[.,]\d+", value)
+        scientific = re.search(r"[eE][+-]?\d+$", value)
+        unit = unit_pattern.match(text, number.end())
+        if not unit and re.search(r"\(\d{2,4}\)\s*$", prefix):
+            continue
+        if fractional or scientific or unit:
+            spans.append(number.span())
+    return spans
 
 
