+QUESTION_LABEL = r"(?:Question|Вопрос|Q)\s*(?:\d+)?\s*:"
+
+
+def split_questions(query: str) -> list[str]:
+    # Labels and completed questions are boundaries; ordinary wrapped lines are not.
+    line_boundary = (
+        r"|\n(?=\s*(?:what|which|who|where|when|why|how|"
+        r"что|какой|какая|какие|каково|кто|где|когда|почему|как|сколько)\b)"
+        if "?" not in query else ""
+    )
+    parts = re.split(
+        rf"\b{QUESTION_LABEL}\s*|(?:^|\n)\s*\d+[.):]\s+|(?<=\?)\s+"
+        + line_boundary,
+        query, flags=re.IGNORECASE,
+    )
+    return [part.strip() for part in parts if part.strip()] or [query]
+
+
