+QUESTION_LABEL_RE = re.compile(
+    r"(?:\b(?:question|вопрос|q)\s*\d*\s*[:.)]|(?:^|(?<=\n)|(?<=\?))\s*\d+[.)])\s*",
+    re.IGNORECASE,
+)
+
+
+def split_questions(query: str) -> list[str]:
+    # Labels and question terminators delimit questions; a soft line break does not.
+    labelled = QUESTION_LABEL_RE.split(query)
+    questions = []
+    for part in labelled:
+        for question in re.split(r"(?<=\?)\s+", part.strip()):
+            if question.strip():
+                questions.append(" ".join(question.split()))
+    return questions
+
