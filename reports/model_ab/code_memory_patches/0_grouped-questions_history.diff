+def split_query_questions(query: str) -> list[str]:
+    labelled = re.split(QUESTION_LABEL_RE, query, flags=re.IGNORECASE | re.MULTILINE)
+    parts = labelled[1:] if len(labelled) > 1 else [query]
+    questions = []
+    for part in parts:
+        part = re.split(r"\b(?:Answer|Ответ)\s*:", part, maxsplit=1, flags=re.IGNORECASE)[0]
+        # Wrapped continuation lines stay with their question.
+        boundary = r"(?<=\?)\s+|\n(?=" + QUESTION_START_RE + r")"
+        for question in re.split(boundary, part.strip(), flags=re.IGNORECASE | re.MULTILINE):
+            if content_terms(question):
+                questions.append(question)
+    return questions or [query]
 
 
