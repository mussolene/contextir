+def split_query_questions(query: str) -> list[str]:
+    # A line break alone can be a continuation of the same question.
+    labels = list(re.finditer(
+        r"(?:\b(?:questions?|вопрос(?:ы)?|q)\s*\d*\s*[:.)]|^\s*(?:\d+[.)]|[-*])\s+)",
+        query, re.IGNORECASE | re.MULTILINE,
+    ))
+    blocks = [
+        query[label.end():labels[index + 1].start() if index + 1 < len(labels) else len(query)]
+        for index, label in enumerate(labels)
+    ] if labels else [query]
+    questions = []
+    for block in blocks:
+        block = re.split(r"\b(?:Answer|Ответ)\s*:", block, maxsplit=1, flags=re.IGNORECASE)[0]
+        questions.extend(part.strip() for part in re.split(r"(?<=\?)\s+", block) if part.strip())
+    return questions
+
+
