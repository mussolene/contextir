+QUESTION_LABEL_RE = re.compile(
+    r"(?:\b(?:Question(?:\s+\d+)?|Q\d*|Вопрос(?:\s+\d+)?)\s*:|^\s*\d+[.)]\s+)",
+    re.IGNORECASE | re.MULTILINE,
+)
+
+
+def split_questions(query: str) -> list[str]:
+    """Separate labels and completed question lines while retaining wrapped lines."""
+    questions = []
+    labels = list(QUESTION_LABEL_RE.finditer(query))
+    parts = [
+        query[label.end():labels[index + 1].start() if index + 1 < len(labels) else len(query)]
+        for index, label in enumerate(labels)
+    ] if labels else [query]
+    for part in parts:
+        questions.extend(
+            piece.strip() for piece in re.split(r"(?<=\?)\s*\n+", part) if piece.strip()
+        )
+    return questions
+
+
 def extract_query(text: str, segments: list[tuple[str, str]]) -> str:
+    labels = list(QUESTION_LABEL_RE.finditer(text))
+    if labels:
+        questions = []
+        for index, label in enumerate(labels):
+            end = labels[index + 1].start() if index + 1 < len(labels) else len(text)
+            body = re.split(r"\b(?:Answer|Ответ)\s*:", text[label.end():end], maxsplit=1, flags=re.IGNORECASE)[0].strip()
+            if body:
+                questions.append((label.group().strip(), body))
+        if len(questions) == 1:
+            return questions[0][1]
+        return "\n".join(label + " " + body for label, body in questions)
