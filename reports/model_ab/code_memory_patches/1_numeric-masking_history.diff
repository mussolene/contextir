+def phone_match_is_numeric(match: re.Match[str], text: str) -> bool:
+    # Explicit phone labels take priority over ambiguous decimal or unit syntax.
+    if _PHONE_LABEL.search(text[: match.start()]):
+        return False
+    for number in _NUMERIC_VALUE.finditer(text):
+        if number.start() >= match.end():
+            break
