+        if not lines[index].strip():
+            index += 1
+            continue
+        start = index
+        fence = re.match(r" {0,3}(`{3,}|~{3,})", lines[index])
+        if fence:
+            marker = fence.group(1)
+            index += 1
+            while index < len(lines):
+                closing = re.fullmatch(
+                    r" {0,3}" + re.escape(marker[0]) + "{" + str(len(marker)) + r",}[ \t]*(?:\r?\n)?",
+                    lines[index],
+                )
+                index += 1
+                if closing:
+                    break
+        else:
+            is_list = bool(re.match(r"[ \t]*(?:[-+*]|\d+[.)])[ \t]+", lines[index]))
+            is_table = "|" in lines[index]
+            index += 1
+            while index < len(lines):
+                line = lines[index]
+                if not line.strip():
+                    following = index + 1
+                    while following < len(lines) and not lines[following].strip():
+                        following += 1
+                    if is_list and following < len(lines) and re.match(
+                        r"(?:[ \t]+\S|[ \t]*(?:[-+*]|\d+[.)])[ \t]+)", lines[following]
+                    ):
+                        index = following
+                        continue
+                    break
+                if re.match(r" {0,3}(?:`{3,}|~{3,}|#{1,6}\s)|(?:Question|Answer):", line):
+                    break
+                next_list = bool(re.match(r"[ \t]*(?:[-+*]|\d+[.)])[ \t]+", line))
+                next_table = "|" in line
+                if not is_list and (is_table != next_table or next_list):
+                    break
+                index += 1
