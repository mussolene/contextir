+def preserve_source_blocks(
+    text: str,
+    segments: list[tuple[str, str]],
+    profile: TaskProfile,
+) -> tuple[list[tuple[str, str]], TaskProfile]:
+    """Expand retrieval hits to their original, indivisible document blocks."""
+    lines = text.splitlines(keepends=True)
+    if len(lines) < 2:
+        return segments, profile
+    offsets = [0]
+    for line in lines:
+        offsets.append(offsets[-1] + len(line))
+    blocks = []
+    index = 0
+    while index < len(lines):
+        if not lines[index].strip():
+            index += 1
+            continue
+        start = index
+        fence = re.match(r" {0,3}(`{3,}|~{3,})", lines[index])
+        if fence:
+            marker = fence.group(1)
+            index += 1
+            while index < len(lines):
+                closing = re.fullmatch(
+                    r" {0,3}" + re.escape(marker[0]) + "{" + str(len(marker)) + r",}[ \t]*(?:\r?\n)?",
+                    lines[index],
+                )
+                index += 1
+                if closing:
+                    break
+        else:
+            is_list = bool(re.match(r"\s*(?:[-+*]|\d+[.)])[ \t]+", lines[index]))
+            is_table = "|" in lines[index]
+            index += 1
+            while index < len(lines):
+                line = lines[index]
+                if not line.strip():
+                    following = index + 1
+                    while following < len(lines) and not lines[following].strip():
+                        following += 1
+                    if is_list and following < len(lines) and re.match(
+                        r"(?:[ \t]+\S|\s*(?:[-+*]|\d+[.)])[ \t]+)", lines[following]
+                    ):
+                        index = following
+                        continue
+                    break
+                if re.match(r" {0,3}(?:`{3,}|~{3,}|#{1,6}[ \t])", line):
+                    break
+                next_list = bool(re.match(r"\s*(?:[-+*]|\d+[.)])[ \t]+", line))
+                if (not is_list and next_list) or (not is_list and ("|" in line) != is_table):
+                    break
+                index += 1
+        blocks.append((offsets[start], offsets[index]))
+
+    expanded = []
+    owner_by_ref = {}
+    cursor = 0
+    block_index = 0
+    for ref, value in segments:
+        position = text.index(value, cursor)
+        cursor = position + len(value)
+        while block_index + 1 < len(blocks) and position >= blocks[block_index][1]:
+            block_index += 1
+        start, end = blocks[block_index]
+        if not expanded or start != expanded[-1][2]:
+            expanded.append((ref, text[start:end].rstrip("\r\n"), start))
+        owner_by_ref[ref] = expanded[-1][0]
+    return [(ref, value) for ref, value, _start in expanded], replace(
+        profile,
+        query_refs=tuple(dict.fromkeys(owner_by_ref[ref] for ref in profile.query_refs)),
+        evidence_refs=tuple(dict.fromkeys(owner_by_ref[ref] for ref in profile.evidence_refs)),
+    )
 
 
